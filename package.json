{
  "name": "laravel-translator",
  "type": "module",
  "version": "3.0.0-rc.1",
  "description": "Laravel localization bridge for your frontend.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "index": [
        "dist/index.d.ts"
      ],
      "vite": [
        "dist/vite.d.ts"
      ],
      "vue": [
        "dist/vue.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ],
      "svelte": [
        "dist/svelte.d.ts"
      ],
      "vanilla": [
        "dist/vanilla.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "tests": "vitest --run",
    "build": "tsup ./src --external virtual-laravel-translations,vue --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergix44/laravel-translator-js.git"
  },
  "author": "Sergio Brighenti",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sergix44/laravel-translator-js/issues"
  },
  "homepage": "https://github.com/sergix44/laravel-translator-js#readme",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "php-parser": "^3.7.0"
  }
}
